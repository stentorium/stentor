{
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stentorium/stentor"
  },
  "workspaces": [
    "packages/*",
    "website"
  ],
  "devDependencies": {
    "@microsoft/api-documenter": "7.30.13",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@xapp/config": "0.3.0",
    "eslint": "8.57.1",
    "eslint-plugin-notice": "1.0.0",
    "knip": "6.34.0",
    "lerna": "10.0.1",
    "license-checker": "25.0.1",
    "mocha": "11.8.0",
    "mocha-junit-reporter": "2.2.1",
    "nyc": "18.0.0",
    "syncpack": "15.3.3",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0"
  },
  "scripts": {
    "api": "lerna run api",
    "docs": "typedoc && node scripts/fix-api-docs.js",
    "docs:build": "yarn docs && cd website && yarn build",
    "docs:serve": "cd website && yarn start",
    "docs:deploy": "cd website && GIT_USER=${GIT_USER} yarn deploy",
    "lerna": "lerna",
    "clean": "lerna run clean",
    "clean:modules": "lerna clean",
    "lint": "eslint 'packages/**/src/**/*.{ts,tsx}'",
    "build": "lerna run build",
    "website": "yarn workspace website start",
    "test": "TZ=UTC lerna run test",
    "test:ci": "TZ=UTC lerna run test --concurrency 1 -- --reporter mocha-junit-reporter",
    "license-check": "license-checker --production --start './packages/stentor/' --exclude ISC,MIT,Apache-2.0,BSD-3-Clause,BSD-2-Clause --failOn GPL-3.0",
    "version-check": "syncpack list-mismatches --types dev,prod --filter 'stentor-'",
    "version-check:all": "syncpack list-mismatches --types dev,prod",
    "knip": "knip"
  },
  "resolutions": {
    "xmldoc": "2.0.3"
  },
  "packageManager": "yarn@4.18.0"
}
