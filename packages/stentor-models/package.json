{
  "name": "stentor-models",
  "repository": {
    "type": "git",
    "url": "https://github.com/stentorium/stentor.git",
    "directory": "packages/stentor-models"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.76.0",
  "description": "Models for 📣 stentor",
  "types": "lib/index",
  "typings": "lib/index",
  "main": "lib/index",
  "files": [
    "lib",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.12",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@xapp/config": "0.3.0",
    "chai": "4.5.0",
    "mocha": "11.8.0",
    "rollup": "3.30.0",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "7.0.2"
  },
  "scripts": {
    "api": "api-extractor run --local",
    "build": "tsc -d true -p .",
    "dist": "rollup -c",
    "clean": "rm -rf ./lib/* && rm -rf ./dist/*",
    "types": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && mocha --recursive -r ts-node/register \"./src/**/*.test.ts\""
  },
  "dependencies": {
    "@xapp/patterns": "2.0.3"
  }
}
