{
  "name": "stentor-utils",
  "repository": {
    "type": "git",
    "url": "https://github.com/stentorium/stentor.git",
    "directory": "packages/stentor-utils"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "version": "1.75.2",
  "description": "Utilities for stentor",
  "types": "lib/index",
  "main": "lib/index",
  "module": "esm/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./esm/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "esm"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.12",
    "@types/blueimp-md5": "2.18.2",
    "@types/chai": "5.2.3",
    "@types/lodash.keys": "4.2.9",
    "@types/lodash.sumby": "4.6.9",
    "@types/lodash.union": "4.6.9",
    "@types/marked": "6.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.13",
    "@types/numeral": "2.0.5",
    "@types/sanitize-html": "2.16.1",
    "@types/sinon": "22.0.0",
    "@types/sinon-chai": "3.2.12",
    "@xapp/config": "0.3.0",
    "chai": "4.5.0",
    "mocha": "11.8.0",
    "rollup": "3.30.0",
    "sinon": "22.1.0",
    "sinon-chai": "3.7.0",
    "stentor-models": "1.78.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@types/xmldoc": "2.0.0",
    "blueimp-md5": "2.19.0",
    "dyno-item-size": "0.3.3",
    "fuse.js": "7.4.2",
    "html-entities": "2.6.0",
    "jsonpath-plus": "10.4.0",
    "lodash.keys": "4.2.0",
    "lodash.sumby": "4.6.0",
    "lodash.union": "4.6.0",
    "marked": "12.0.2",
    "marked-xhtml": "1.0.15",
    "number-to-words": "1.2.4",
    "numeral": "2.0.6",
    "sanitize-html": "2.17.7",
    "slugify": "1.6.9",
    "stentor-constants": "1.74.4",
    "stentor-guards": "1.74.4",
    "words-to-numbers": "1.5.1",
    "xmldoc": "2.0.3"
  },
  "peerDependencies": {
    "stentor-models": "1.x"
  },
  "scripts": {
    "api": "api-extractor run --local",
    "build": "tsc -d true -p . && tsc -p tsconfig.esm.json && node ./scripts/finalize-esm.js",
    "clean": "rm -rf ./lib/* ./esm/*",
    "test": "TZ=UTC mocha --recursive -r ts-node/register \"./src/**/*.test.ts\""
  }
}
