{
  "extends": "@xapp/config/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "esModuleInterop": true,
    "strictNullChecks": false,
    "types": [
      "node",
      "mocha"
    ],
    "lib": [
      "es2016"
    ]
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "commonjs"
    },
    "experimentalResolver": true
  },
  "include": [
    "src",
    "typings/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/__test__/*",
    "src/**/*.test.ts"
  ]
}
